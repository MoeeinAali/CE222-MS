%% Infrastructure → Interface Adapters
PG      -->|"implements"| REPO_IMPL
RD      -->|"cache"| REPO_IMPL
PAY     -->|"implements"| GW_PAY
MAIL    -->|"implements"| GW_MAIL
CDN     -->|"implements"| GW_STORE
WEB     -->|"routes to"| MW
AUTH_P  -->|"verifies"| MW
MQ      -->|"publishes"| GW_MAIL

%% Interface Adapters → Application
MW          -->|"passes request"| CTRL_E
MW          -->|"passes request"| CTRL_L
MW          -->|"passes request"| CTRL_Q
MW          -->|"passes request"| CTRL_C
CTRL_E      -->|"calls"| UC_E
CTRL_L      -->|"calls"| UC_P
CTRL_Q      -->|"calls"| UC_Q
CTRL_C      -->|"calls"| UC_C
REPO_IMPL   -->|"implements"| RI_C
REPO_IMPL   -->|"implements"| RI_E
REPO_IMPL   -->|"implements"| RI_P
GW_PAY      -->|"implements"| PORT_PAY
GW_MAIL     -->|"implements"| PORT_MAIL
GW_STORE    -->|"implements"| PORT_STORE
UC_E        -->|"returns"| PRESENTER
UC_P        -->|"returns"| PRESENTER

%% Application → Domain
UC_E    -->|"creates"| E_ENR
UC_E    -->|"uses"| PORT_PAY
UC_E    -->|"emits"| EV1
UC_P    -->|"reads"| E_LES
UC_P    -->|"uses"| PORT_STORE
UC_P    -->|"emits"| EV2
UC_Q    -->|"reads"| E_QUZ
UC_Q    -->|"emits"| EV3
UC_T    -->|"updates"| E_PRG
UC_C    -->|"creates"| E_CRS
UC_E    -->|"queries"| RI_E
UC_C    -->|"queries"| RI_C
UC_T    -->|"queries"| RI_P

