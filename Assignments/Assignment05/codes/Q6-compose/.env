# Read automatically by `docker compose` and interpolated INTO docker-compose.yaml.
# (different mechanism from `env_file:`, which injects variables INTO a container)
COMPOSE_PROJECT_NAME=ms-hw5-compose

APP_IMAGE=composeprac
APP_PORT=8080

HELPER_IMAGE=hw5-helper:1.0.0
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:1.27-alpine
